# Copie para .env.prod (NUNCA versione o .env.prod) e preencha. A API se recusa a subir com valores ausentes,
# fracos ou de exemplo (ProductionConfigValidator).

# ---- Banco: três usuários (privilégio mínimo) ----
DATABASE_NAME=bolso
# superusuário: só cria o banco e os papéis; a API nunca recebe esta senha.   openssl rand -base64 24
DATABASE_ADMIN_USERNAME=postgres
DATABASE_ADMIN_PASSWORD=
# dono das tabelas: só as migrações (Flyway) usam
DATABASE_MIGRATION_USERNAME=bolso_owner
DATABASE_MIGRATION_PASSWORD=
# aplicação: só lê e grava dados (sem CREATE/ALTER/DROP)
DATABASE_USERNAME=bolso_app
DATABASE_PASSWORD=

# ---- Segredo dos tokens de login ----   openssl rand -base64 48
JWT_SECRET=

# ---- Front-end: origem exata, https ----
CORS_ALLOWED_ORIGINS=https://bolso.seudominio.com.br

# Fuso do "hoje" (saldo e mês atual)
APP_TIMEZONE=America/Sao_Paulo

# ---- Telegram (opcional): lançar gastos por mensagem e lembretes das contas fixas ----
# Crie o bot com o @BotFather (/newbot) e cole o token. O token dá controle total do bot: trate como senha.
# A API só faz conexões de saída (long polling): não é preciso abrir porta nem ter webhook.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
